IMAGE_NAME = "bento/fedora-43"

Vagrant.configure("2") do |config|
    config.ssh.insert_key = false

    config.vm.provider "virtualbox" do |v|
        v.memory = 1024
        v.cpus = 1
    end

    config.vm.define "fedora" do |fedora|
        fedora.vm.box = IMAGE_NAME
        fedora.vm.box_version = "202511.16.0"
        fedora.vm.network "forwarded_port", guest: 22, host: 2204, host_ip: "127.0.0.1"
        fedora.vm.hostname = "fedora43"
    end

end
